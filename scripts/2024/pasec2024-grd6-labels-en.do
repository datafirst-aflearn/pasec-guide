    asarray(valmap, "Disponible pour une partie du cycle seulement", "available for only part of the cycle")
    asarray(valmap, "Disponible pour tout le cycle", "available for the whole cycle")
    asarray(valmap, "5 heures et plus", "5 hours or more")
    asarray(valmap, "4 heures", "4 hours")

    asarray(valmap, "Occasionnel : moins d'un jour par mois(pas plus de 5 jours dans l'année)", "occasional: less than one day a month (no more than 5 days a year)")
    asarray(valmap, "Fréquent : un à trois jours par mois", "frequent: one to three days a month")
    asarray(valmap, "Très fréquent : plus de trois jours par mois", "very frequent: more than three days a month")
    asarray(valmap, "two or more times", "two or more times")

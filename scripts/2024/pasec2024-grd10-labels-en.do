        v = st_varname(i)
        if (asarray_contains(varmap, strlower(v))) {
            st_varlabel(v, asarray(varmap, strlower(v)))
        }
    }

    vlnames = tokens(st_local("__pasec_vallabs"))
    seen = asarray_create("string", 1)
    for (i = 1; i <= cols(vlnames); i++) {
        vlname = vlnames[i]
        if (vlname == "" | asarray_contains(seen, vlname)) continue
        asarray(seen, vlname, 1)
        st_vlload(vlname, vals, txt)
        changed = 0
        for (j = 1; j <= rows(txt); j++) {
            if (asarray_contains(valmap, txt[j])) {
                txt[j] = asarray(valmap, txt[j])
                changed = 1
            }
        }
        if (changed) st_vlmodify(vlname, vals, txt)
    }
}
